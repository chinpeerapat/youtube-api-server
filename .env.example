# Server configuration
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Logging
LOG_LEVEL=INFO

# CORS
BACKEND_CORS_ORIGINS=*

# Generic HTTP proxy for metadata/oEmbed calls
ENABLE_PROXY=false
PROXY_TYPE=http
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Webshare proxy for YouTube transcript calls
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
WEBSHARE_PROXY_LOCATIONS=de,us

# Optional endpoint authentication
ENABLE_AUTH=false
AUTH_TYPE=api_key
API_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
